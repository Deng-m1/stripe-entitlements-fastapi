DATABASE_URL=postgresql://postgres:local-only@127.0.0.1:55439/stripe_entitlements
# This is a per-process/warm-instance budget, not a deployment-wide pool.
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=4
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=10000
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2026-06-24.dahlia
# Must match an actually delivered, signature-verified Event payload. It is not
# automatically the same as STRIPE_API_VERSION.
STRIPE_WEBHOOK_API_VERSION=2026-06-24.dahlia
# Run `npx stripe-entitlements bootstrap`, then replace this with the returned
# secret-free `portalConfigurationId` before starting the API.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
PRODUCT_LINE=example-entitlements
LOOKUP_PREFIX=ent
# Omit PLAN_CATALOG_PATH to use the package-bundled canonical plans.toml.
# PLAN_CATALOG_PATH=/absolute/path/to/plans.toml
# Live bootstrap confirmation is deliberately CLI-only; there is no environment
# variable that can silently opt a deployment into live catalog mutations.
BILLING_TRANSITION_POLICY=full_period_reset
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:3000/pricing
PORTAL_RETURN_URL=http://localhost:3000/account
FRONTEND_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
APP_ENV=development

# Local test-mode demo only. Leave disabled by default; if needed, generate a random
# token (for example `openssl rand -hex 32`) and never deploy it as production auth.
# DEMO_BEARER_TOKEN=replace_with_a_fresh_local_random_value
# DEMO_BEARER_SUBJECT=demo-user
# DEMO_BEARER_EMAIL=demo@example.test

# Standalone Node listener.
BILLING_HOST=0.0.0.0
BILLING_PORT=8000
BILLING_PUBLIC_ORIGIN=http://127.0.0.1:8000

# Production personal-user JWT/JWKS starter.
# BILLING_AUTH_MODE=personal_jwt
# BILLING_JWT_ISSUER=https://identity.example.com/
# BILLING_JWT_AUDIENCE=billing-api
# BILLING_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# BILLING_JWT_ALGORITHMS=RS256

# Required only when HTTP scheduler routes are deployed.
# CRON_SECRET=replace_with_at_least_16_random_visible_ascii_characters

# Local-only opt-in. Apply migrations as an explicit deployment step in production.
# BILLING_APPLY_MIGRATIONS=1

# origin-if-present is suitable for Bearer-token APIs; use same-origin-session only
# with a deliberately tested cookie/session integration.
# BILLING_CSRF_MODE=origin-if-present
