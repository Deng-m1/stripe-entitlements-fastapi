# Local UI development is intentionally explicit demo mode.
# The production runtime rejects mock mode and NEXT_PUBLIC_DEMO_BEARER_TOKEN.
NEXT_PUBLIC_BILLING_API_MODE=mock

# HTTP integration mode:
# NEXT_PUBLIC_BILLING_API_MODE=http
# NEXT_PUBLIC_BILLING_API_BASE_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
#
# Optional local-only placeholder. This is NOT production authentication.
# NEXT_PUBLIC_DEMO_BEARER_TOKEN=demo-local-token
