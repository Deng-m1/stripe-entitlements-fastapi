DATABASE_URL=postgresql://postgres:local-only@127.0.0.1:55439/stripe_entitlements
# Keep this per-process budget small for serverless/warm-instance deployments.
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=10000
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_API_VERSION=2026-06-24.dahlia
# Dedicated Portal configuration created by scripts/bootstrap_stripe.py.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me
PRODUCT_LINE=example-entitlements
LOOKUP_PREFIX=ent
PLAN_CATALOG_PATH=plans.toml
# full_period_reset starts a new full-price period; prorated_delta keeps the current
# monthly period and supports only higher-tier monthly difference upgrades.
BILLING_TRANSITION_POLICY=full_period_reset
# Query-free and fragment-free base; the server appends target/session fields.
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:3000/pricing
# Reserved, must not be enabled standalone: there is intentionally no
# CHECKOUT_ALLOW_PROMOTION_CODES switch. Checkout Session creation never sends
# allow_promotion_codes, because every discounted Invoice fails closed (Stripe
# collects the money, no entitlement is granted, a durable incident is opened).
# Promotion codes require an explicit coupon funding policy before any UI switch.
PORTAL_RETURN_URL=http://localhost:3000/account
# Required. Must match the signed payload version pinned on the actual endpoint.
STRIPE_WEBHOOK_API_VERSION=2026-06-24.dahlia
FRONTEND_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Local-only opt-in authenticated demo. Production defaults to fail closed.
APP_ENV=development
DEMO_BEARER_TOKEN=replace_with_local_random_value
DEMO_BEARER_SUBJECT=demo-user
DEMO_BEARER_EMAIL=demo@example.test

# Vercel Services / other personal-JWT deployment. Production remains reject-all
# unless BILLING_AUTH_MODE is explicitly changed to personal_jwt with all fields.
# BILLING_AUTH_MODE=personal_jwt
# BILLING_JWT_ISSUER=https://identity.example.com/
# BILLING_JWT_AUDIENCE=billing-api
# BILLING_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# BILLING_JWT_ALGORITHMS=RS256
# Vercel automatically sends this value as Authorization: Bearer <value> to Cron.
# Generate an environment-specific random value with at least 16 visible ASCII chars.
# CRON_SECRET=replace_with_random_scheduler_secret
