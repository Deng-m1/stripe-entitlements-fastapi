{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "application": {
      "root": "web/",
      "framework": "nextjs",
      "installCommand": "npm ci"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "application" }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/annual-grants",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "*/5 * * * *"
    }
  ]
}
