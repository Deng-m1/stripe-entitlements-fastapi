  "eventOrdering": [
    {
      "name": "later event wins regardless of rank",
      "current": { "created": "10", "type": "customer.subscription.deleted" },
      "event": { "created": "11", "type": "unknown" },
      "wins": true
    },
    {
      "name": "same-second deletion outranks paid",
      "current": { "created": "10", "type": "invoice.paid" },
      "event": { "created": "10", "type": "customer.subscription.deleted" },
      "wins": true
    },
    {
      "name": "same-second paid outranks update",
      "current": { "created": "10", "type": "customer.subscription.updated" },
      "event": { "created": "10", "type": "invoice.paid" },
      "wins": true
    },
    {
      "name": "same-second update outranks failure",
      "current": { "created": "10", "type": "invoice.payment_failed" },
      "event": { "created": "10", "type": "customer.subscription.updated" },
      "wins": true
    },
    {
      "name": "older event loses regardless of rank",
      "current": { "created": "11", "type": "invoice.payment_failed" },
      "event": { "created": "10", "type": "customer.subscription.deleted" },
      "wins": false
    }
  ],
